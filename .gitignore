# ==========================================
# Invoice Intelligence Monorepo .gitignore
# ==========================================

# Dependencies (Root, Backend, and Frontend)
node_modules/
backend/node_modules/
frontend/node_modules/
.pnpm-store/
.yarn/

# Production Build Outputs
dist/
backend/dist/
frontend/dist/
build/
*.tsbuildinfo

# Vite & Bundler Cache Directories
.vite/
frontend/.vite/
.cache/
.parcel-cache/

# Local Environment Variables & Secrets (Keep .env.example tracked)
.env
.env.local
.env.*.local
*.env
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local
!*.env.example
!backend/.env.example

# Runtime Uploads Storage (Preserve uploads directory with .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs & System Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.system_generated/

# Testing & Coverage Outputs
coverage/
.nyc_output/

# IDE & Operating System Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
