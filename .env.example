# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (MongoDB - MERN stack)
MONGODB_URI=mongodb://127.0.0.1:27017/invoice_intelligence

# AI Provider Configuration (Google Gemini Free Tier / AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Storage & Upload Pipeline Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
MAX_FILES_PER_BATCH=20
